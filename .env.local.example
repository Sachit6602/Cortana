# Copy to .env.local and fill in. Never commit .env.local.
#
# Where the Hermes API is reachable. With the desktop app this is the local
# end of the SSH tunnel it opens for you.
HERMES_API=http://127.0.0.1:9500

# Must match the token the Hermes backend was started with:
#   HERMES_DASHBOARD_SESSION_TOKEN=<your-token> hermes serve --port 9500
# Generate one with:  openssl rand -hex 24
HERMES_TOKEN=<your-token>

# SSH host the desktop app forwards through (an entry in ~/.ssh/config).
CORTANA_SSH_HOST=cortana
